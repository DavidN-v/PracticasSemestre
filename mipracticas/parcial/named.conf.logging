logging {
    channel consultas_dns {
        file "/var/log/named/consultas.log" versions 3 size 5m;
        severity info;
        print-time yes;
        print-category yes;
        print-severity yes;
    };

    category queries {
        consultas_dns;
    };

    category security {
        consultas_dns;
    };

    category xfer-in {
        consultas_dns;
    };

    category xfer-out {
        consultas_dns;
    };
};
