logging {
    channel consultas_dns {
        file "/var/log/named/consultas.log" versions 3 size 5m;
        severity info;
        print-time yes;
        print-category yes;
        print-severity yes;
    };

    channel transferencias_dns {
        file "/var/log/named/transferencias.log" versions 3 size 5m;
        severity info;
        print-time yes;
        print-category yes;
        print-severity yes;
    };

    channel seguridad_dns {
        file "/var/log/named/seguridad.log" versions 3 size 5m;
        severity info;
        print-time yes;
        print-category yes;
        print-severity yes;
    };

    category queries {
        consultas_dns;
    };

    category xfer-in {
        transferencias_dns;
    };

    category xfer-out {
        transferencias_dns;
    };

    category security {
        seguridad_dns;
    };
};
