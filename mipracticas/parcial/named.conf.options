options {
        directory "/var/cache/bind";

        listen-on { 127.0.0.1; 192.168.50.3; };
        listen-on-v6 { any; };

        recursion no;
        allow-query { 127.0.0.1; 192.168.50.0/24; };

        dnssec-validation auto;

        rate-limit {
                responses-per-second 5;
                window 5;
        };
};
